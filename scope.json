{
	"reasons": {
		"legacy": "Legacy mode: every component is a runes component",
		"async": "`experimental.async`, `fork` and pending boundaries",
		"custom-renderers": "Custom renderers (`svelte/renderer`)",
		"self-invalidation": "An effect re-running because of a write it made itself",
		"teardown-old-values": "Teardown functions reading the values from before the change, and block changes that wait for the end of a flush",
		"delegation": "Event delegation: a handler is attached to the element it is on",
		"spread": "Special cases of inputs, `autofocus` and custom elements in spread attributes",
		"action-deep-read": "`use:` actions updating when their parameter is mutated in place",
		"error-codes": "Named error codes in production builds",
		"mount-events": "The deprecated `events` option of `mount` and `hydrate`: callback props take its place",
		"motion-stores": "The deprecated `spring` and `tweened` stores of `svelte/motion`: the `Spring` and `Tween` classes take their place",
		"svelte-legacy": "`svelte/legacy`, deprecated as a whole: `mount` and `hydrate` take the place of `createClassComponent` and `asClassComponent`, `$effect.pre` that of `run`, plain functions that of `handlers` and the event modifier functions, callback props that of `createBubbler`",
		"component-api-4": "The deprecated `compatibility.componentApi: 4` compiler option, which makes components classes through `svelte/legacy`: `mount` takes its place",
		"on-directive": "`on:` directives on elements, deprecated: event attributes (`onclick`) take their place. svelte-lite rejects them when compiling",
		"event-forwarding": "Event forwarding (`on:click` without a handler), deprecated: a callback prop that the component passes on takes its place. svelte-lite rejects it when compiling",
		"slot-element": "`<slot>` outside a custom element, deprecated: `{@render ...}` of a snippet prop takes its place. svelte-lite rejects it when compiling",
		"slot-fill": "Filling a slot with `slot=\"...\"` or `<svelte:fragment>`, deprecated: passing a snippet takes its place. svelte-lite rejects them when compiling",
		"let-directive": "`let:` directives, deprecated: a snippet that takes the values as parameters takes their place. svelte-lite rejects them when compiling",
		"svelte-component": "`<svelte:component>`, deprecated: a component in a variable is used as a tag. svelte-lite rejects it when compiling",
		"svelte-self": "`<svelte:self>`, deprecated: a component that imports itself takes its place. svelte-lite rejects it when compiling"
	},
