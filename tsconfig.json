{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"esnext",
			"dom",
			"dom.iterable"
		],
		"types": [
			"bun"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noErrorTruncation": true,
		"allowJs": true,
		"checkJs": false
	},
	"include": [
		"src",
		"check",
		"compat",
		"harness",
		"scripts",
		"vitest.config.ts"
	]
}
