{
	"name": "svelte-lite",
	"version": "0.0.0",
	"description": "A lean rewrite of Svelte 5",
	"private": true,
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"svelte-custom-renderer": "./src/index-client.ts",
			"worker": "./src/index-server.ts",
			"browser": "./src/index-client.ts",
			"default": "./src/index-server.ts"
		},
		"./package.json": "./package.json",
		"./action": {
			"types": "./src/action/index.ts"
		},
		"./animate": {
			"default": "./src/animate/index.ts"
		},
		"./attachments": {
			"default": "./src/attachments/index.ts"
		},
		"./compiler": {
			"default": "./src/compiler/index.ts"
		},
		"./easing": {
			"default": "./src/easing/index.ts"
		},
		"./elements": {
			"types": "./src/elements.ts"
		},
		"./internal": {
			"default": "./src/internal/index.ts"
		},
		"./internal/client": {
			"default": "./src/internal/client/index.ts"
		},
		"./internal/disclose-version": {
			"default": "./src/internal/disclose-version.ts"
		},
		"./internal/init-operations": {
			"default": "./src/internal/init-operations.ts"
		},
		"./internal/flags/async": {
			"default": "./src/internal/flags/async.ts"
		},
		"./internal/flags/legacy": {
			"default": "./src/internal/flags/legacy.ts"
		},
		"./internal/flags/tracing": {
			"default": "./src/internal/flags/tracing.ts"
		},
		"./internal/flags/custom-renderer": {
			"svelte-custom-renderer": "./src/internal/flags/custom-renderer.ts",
			"browser": "./src/internal/flags/custom-renderer.ts",
			"default": "./src/internal/flags/custom-renderer-server.ts"
		},
		"./internal/server": {
			"default": "./src/internal/server/index.ts"
		},
		"./legacy": {
			"svelte-custom-renderer": "./src/legacy/legacy-client.ts",
			"worker": "./src/legacy/legacy-server.ts",
			"browser": "./src/legacy/legacy-client.ts",
			"default": "./src/legacy/legacy-server.ts"
		},
		"./motion": {
			"default": "./src/motion/index.ts"
		},
		"./reactivity": {
			"svelte-custom-renderer": "./src/reactivity/index-client.ts",
			"worker": "./src/reactivity/index-server.ts",
			"browser": "./src/reactivity/index-client.ts",
			"default": "./src/reactivity/index-server.ts"
		},
		"./reactivity/window": {
			"default": "./src/reactivity/window/index.ts"
		},
		"./renderer": {
			"svelte-custom-renderer": "./src/renderer/index.ts",
			"browser": "./src/renderer/index.ts",
			"default": "./src/renderer/index-server.ts"
		},
		"./server": {
			"default": "./src/server/index.ts"
		},
		"./store": {
			"svelte-custom-renderer": "./src/store/index-client.ts",
			"worker": "./src/store/index-server.ts",
			"browser": "./src/store/index-client.ts",
			"default": "./src/store/index-server.ts"
		},
		"./transition": {
			"default": "./src/transition/index.ts"
		},
		"./events": {
			"default": "./src/events/index.ts"
		}
	},
	"scripts": {
		"setup": "bun scripts/setup.ts",
		"test": "vitest run",
		"test:upstream": "SVELTE_IMPL=upstream vitest run",
		"test:types": "bun scripts/test-types.ts",
		"check": "tsc --noEmit",
		"compat:audit": "bun scripts/compat-audit.ts",
		"upstream:sync-deps": "bun scripts/sync-upstream-deps.ts",
		"upstream:update": "git submodule update --remote --depth 1 vendor/svelte && bun run upstream:sync-deps && bun run compat:audit --scaffold && bun test && bun run test:upstream"
	},
	"devDependencies": {
		"@jridgewell/remapping": "2.3.5",
		"@jridgewell/sourcemap-codec": "1.6.0",
		"@jridgewell/trace-mapping": "0.3.31",
		"@playwright/test": "1.62.1",
		"@sveltejs/acorn-typescript": "1.0.13",
		"@types/aria-query": "5.0.4",
		"@types/bun": "^1.4.0",
		"@types/estree": "1.0.9",
		"@types/node": "20.19.17",
		"@types/trusted-types": "2.0.7",
		"acorn": "8.18.0",
		"aria-query": "5.3.1",
		"axobject-query": "4.1.0",
		"clsx": "2.1.1",
		"devalue": "5.9.2",
		"esbuild": "0.28.1",
		"esm-env": "1.2.1",
		"esrap": "2.4.2",
		"is-reference": "3.0.3",
		"jsdom": "25.0.1",
		"locate-character": "3.0.0",
		"magic-string": "0.30.21",
		"source-map": "0.7.4",
		"tinyglobby": "0.2.17",
		"typescript": "5.5.4",
		"vite": "7.3.5",
		"vitest": "4.1.7",
		"zimmerframe": "1.1.2"
	},
	"overrides": {
		"@jridgewell/gen-mapping": "0.3.5",
		"@jridgewell/resolve-uri": "3.1.1",
		"@jridgewell/set-array": "1.2.1",
		"@standard-schema/spec": "1.1.0",
		"@types/chai": "5.2.3",
		"@types/deep-eql": "4.0.2",
		"@vitest/expect": "4.1.7",
		"@vitest/mocker": "4.1.7",
		"@vitest/pretty-format": "4.1.7",
		"@vitest/runner": "4.1.7",
		"@vitest/snapshot": "4.1.7",
		"@vitest/spy": "4.1.7",
		"@vitest/utils": "4.1.7",
		"agent-base": "7.1.1",
		"assertion-error": "2.0.1",
		"asynckit": "0.4.0",
		"chai": "6.2.2",
		"combined-stream": "1.0.8",
		"convert-source-map": "2.0.0",
		"cssstyle": "4.1.0",
		"data-urls": "5.0.0",
		"debug": "4.4.3",
		"decimal.js": "10.4.3",
		"delayed-stream": "1.0.0",
		"entities": "4.5.0",
		"es-module-lexer": "2.1.0",
		"estree-walker": "3.0.3",
		"expect-type": "1.3.0",
		"fdir": "6.5.0",
		"form-data": "4.0.0",
		"html-encoding-sniffer": "4.0.0",
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.5",
		"iconv-lite": "0.6.3",
		"is-potential-custom-element-name": "1.0.1",
		"mime-db": "1.52.0",
		"mime-types": "2.1.35",
		"ms": "2.1.3",
		"nanoid": "3.3.13",
		"nwsapi": "2.2.12",
		"obug": "2.1.1",
		"parse5": "7.1.2",
		"pathe": "2.0.3",
		"picocolors": "1.1.1",
		"picomatch": "4.0.4",
		"playwright": "1.62.1",
		"playwright-core": "1.62.1",
		"postcss": "8.5.15",
		"punycode": "2.3.1",
		"rollup": "4.62.2",
		"rrweb-cssom": "0.7.1",
		"safer-buffer": "2.1.2",
		"saxes": "6.0.0",
		"siginfo": "2.0.0",
		"source-map-js": "1.2.1",
		"stackback": "0.0.2",
		"std-env": "4.1.0",
		"symbol-tree": "3.2.4",
		"tinybench": "2.9.0",
		"tinyexec": "1.1.2",
		"tinyrainbow": "3.1.0",
		"tldts": "6.1.64",
		"tldts-core": "6.1.64",
		"tough-cookie": "5.0.0",
		"tr46": "5.0.0",
		"undici-types": "6.21.0",
		"w3c-xmlserializer": "5.0.0",
		"webidl-conversions": "7.0.0",
		"whatwg-encoding": "3.1.1",
		"whatwg-mimetype": "4.0.0",
		"whatwg-url": "14.0.0",
		"why-is-node-running": "2.3.0",
		"ws": "8.18.0",
		"xml-name-validator": "5.0.0",
		"xmlchars": "2.2.0"
	}
}
